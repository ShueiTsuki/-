<Project Sdk="Microsoft.NET.Sdk">
  <!--
    离线测试工程：直接编译模组的整个 Core/ 目录（不复制、不按子目录挑选）。
    Core/ 不得引用 XNA/tModLoader —— 由 _tools/check_arch.ps1 强制；
    所以 Core 里新增任何目录都会自动进入测试网，不会被静默漏掉。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>vmtest</AssemblyName>
    <RootNamespace>HexCastingTerraria</RootNamespace>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\HexCastingTerraria\Core\**\*.cs" LinkBase="Core" />
    <!-- 附属的纯逻辑同一条规矩：Addons/*/Core 零 Terraria 引用，全部进测试网（ADDONS.md） -->
    <Compile Include="..\..\HexCastingTerraria\Addons\*\Core\**\*.cs" LinkBase="Addons" />
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>
</Project>
