			AshStaff: {
				DisplayName: 灰烬木法杖
				Tooltip: 右键绘制咒术图案
			}
			QuenchedStaff: {
				DisplayName: 淬灵晶法杖
				Tooltip: 以淬灵晶锻造，晶体中回荡着安宁
			}
			EdifiedStaff: {
				DisplayName: 启迪木法杖
				Tooltip: 启迪之木所制，思绪在其纹理间流动
			}
			MindspliceStaff: {
				DisplayName: 剖念法杖
				Tooltip: 剖开思绪本身，窥见其下的结构
			}
			Focus: {
				DisplayName: 聚念核心
				Tooltip:
					'''
					可以存下一个 iota
					配合 read_into_parens 把常用的值随身携带
					'''
			}
			ThoughtKnot: {
				DisplayName: 念珠
				Tooltip:
					'''
					可以存下一个 iota
					绳结记着某个念头，不会散
					'''
			}
			ScrollSmall: {
				DisplayName: 小型卷轴
				Tooltip: 可以存下一个图案
			}
			ScrollMedium: {
				DisplayName: 中型卷轴
				Tooltip: 可以存下一个图案
			}
			ScrollLarge: {
				DisplayName: 大型卷轴
				Tooltip: 可以存下一个图案
			}
			HexSlateItem: {
				DisplayName: 咒术石板
				Tooltip:
					'''
					法术环的一块「指令」
					用手上存着图案的物品右键 → 写入图案
					空手右键 → 顺时针转 90° 改朝向
					朝向必须垂直于控制流方向，否则环走不通
					'''
			}
			HexImpetusItem: {
				DisplayName: 咒术原动力
				Tooltip:
					'''
					法术环的「原动力」
					它本身不含图案 —— 图案写在石板上
					右击启动环；启动前会校验环是否闭合
					'''
			}
			HexDirectrixEmptyItem: {
				DisplayName: 空导线
				Tooltip:
					'''
					法术环的分流器
					随机出轴的一端 —— 用来做概率分支
					空手右键转轴向
					'''
			}
			HexDirectrixBooleanItem: {
				DisplayName: 布尔导线
				Tooltip:
					'''
					法术环的分流器，也是唯一的分支结构
					弹出栈顶布尔值：真出轴向一端、假出另一端
					空手右键转轴向
					'''
			}
			HexDirectrixRedstoneItem: {
				DisplayName: 红石导线
				Tooltip:
					'''
					法术环的分流器
					通电时出轴向一端，否则出另一端
					空手右键转轴向
					'''
			}
