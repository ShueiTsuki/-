# 咒法学 (Hex Casting) → tModLoader 移植版（简体中文）

Mods: {
	HexCastingTerraria: {
		Misc: {
			OnlyHostCanChangeAddons: 只有房主能改附属设置
		}

		// Hexcessible 附属（上游 lang 文件的官方译文）
		// HexDebug 附属（消息是上游 lang 文件的官方译文；调试面板的标签是移植版自己的）
		HexDebug: {
			Connected: 调试客户端已连接！
			NoSession: 线程{0}的调试会话未在运行。
			NotPaused: 线程{0}的调试会话未被暂停。
			DebuggerStopped: 下一个Iota：[{0}] {1}
			IllegalThread: 物品不知怎的失效了……是我还要再提升自己的技术吗？
			OutOfRange: 调试员已离开连接范围。
			ThreadInactive: 线程 {0}
			ThreadActive: 线程 {0}（{1}）

			StepMode: {
				Continue: 模式：继续
				Over: 模式：逐过程
				In: 模式：单步调试
				Out: 模式：单步跳出
				Restart: 模式：重启
				Stop: 模式：停止
			}

			CircleName: 法术环
			FocusHolderItemIs: 物品：{0}

			BadBlock: {
				SplicingTable: 一个剪接台
				Enlightened: 一个制念台
				ClipboardRead: 放有可读副物品的剪接台
				ClipboardWrite: 放有可写副物品的剪接台
				ClipboardSpellbook: 副物品槽中有非空法术书的剪接台
				TableOrHolder: 一个剪接台或核心框架
				TableOrHolderSpellbook: 主物品槽中有非空法术书的剪接台或核心框架
				PositiveOrNull: 一个正整数或Null
				PositiveInt: 一个正整数
				IntBetween: 一个介于{0}和{1}之间的整数
			}

			Splicing: {
				MediaBar: 媒质：{0} / {1}
				NoList: 列表槽里放一个能存列表的物品（核心、法术书……）
				ClipboardIs: 剪贴板：{0}
				Draw: 画图案
				Cast: 激活编辑台

				Button: {
					ViewLeft: 向左移动视野
					ViewLeftPage: 将视野移动到上一页
					ViewLeftFull: 将视野移动到开头
					ViewRight: 向右移动视野
					ViewRightPage: 将视野移动到下一页
					ViewRightFull: 将视野移动到末尾
					CursorLeft: 向左移动光标
					CursorRight: 向右移动光标
					ExpandSelectionLeft: 向左延伸选区
					ExpandSelectionRight: 向右延伸选区
					MoveSelectionLeft: 向左移动选区
					MoveSelectionRight: 向右移动选区
					SelectNone: 取消选区
					SelectAll: 全选
					Undo: 撤销
					Redo: 重做
					NudgeLeft: 左移
					NudgeRight: 右移
					Duplicate: 重复
					Delete: 删除
					Backspace: 退格
					Cut: 剪切
					Copy: 复制
					PasteVerbatim: 粘贴（逐项）
					PasteSplat: 粘贴（扁平化）
					Export: 导出为.hexpattern文件
				}

				Short: {
					CursorLeft: 光标左
					CursorRight: 光标右
					ExpandSelectionLeft: 左扩
					ExpandSelectionRight: 右扩
					MoveSelectionLeft: 选区左
					MoveSelectionRight: 选区右
					SelectNone: 不选
					SelectAll: 全选
					Undo: 撤销
					Redo: 重做
					NudgeLeft: 左移
					NudgeRight: 右移
					Duplicate: 重复
					Delete: 删除
					Backspace: 退格
					Cut: 剪切
					Copy: 复制
					PasteVerbatim: 粘贴
					PasteSplat: 展开粘贴
				}

				Tooltip: {
					Index: 索引下标：{0}
					Depth: 深度：{0}
					Signature: 图案编码：{0}
					Length: 长度：{0}
				}

				Slot: {
					List: 列表
					Clipboard: 剪贴板
					Media: 媒质
					Staff: 法杖
				}
			}

			Panel: {
				Because: （{0}）
				Source: 源码 #{0}
				Empty: （空）
				Stack: 栈（{0}）
				More: 还有 {0} 项
				Ravenmind: 渡鸦之思：{0}
				State3: 已执行操作 {0} · 转义下一个 {1} · 括号层数 {2}
				Yes: 是
				No: 否
				Frames: 调用栈
				Output: 输出
				Hint: 点源码的行设置或取消断点

				State: {
					Running: 运行中
					Pausing: 正在暂停
					Paused: 已暂停
					CaughtMishap: 捕获到事故
					Terminated: 已结束
				}

				Reason: {
					Step: 单步
					Pause: 暂停
					Breakpoint: 断点
					Exception: 事故
					Started: 开始
					Terminated: 结束
				}
			}
		}

		Hexcessible: {
			StartTypingAlias: 为此图案起名……
			StartTyping: 输入名称……
			CountLocked: 还有{0}项已锁定
			WorldSpecificAutocomplete: 此图案的笔顺会因世界不同而变化。把远古卷轴放在快捷栏中手持物品右边一格，再开始绘制以习得绘制方法。
			NoSpace: 无法放置在此处
