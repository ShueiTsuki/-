				DisplayName: 阴森木法杖
				Tooltip: 右键绘制咒术图案
			}
			AshStaff: {
				DisplayName: 灰烬木法杖
				Tooltip: 右键绘制咒术图案
			}
			QuenchedStaff: {
				DisplayName: 淬灵晶法杖
				Tooltip: 以淬灵晶锻造，晶体中回荡着安宁
			}
			EdifiedStaff: {
				DisplayName: 启迪木法杖
				Tooltip: 启迪之木所制，思绪在其纹理间流动
			}
			MindspliceStaff: {
				DisplayName: 剖念法杖
				Tooltip: 剖开思绪本身，窥见其下的结构
			}
			Focus: {
				DisplayName: 核心
				Tooltip:
					'''
					可以存下任意一个 iota
					和蜂巢块合成可密封，erase 会连同密封一起清掉
					'''
			}
			ThoughtKnot: {
				DisplayName: 结念绳
				Tooltip:
					'''
					只能写入一次：写进去的 iota 再也改不了、也清不掉
					'''
			}
			ScrollSmall: {
				DisplayName: 小型卷轴
				Tooltip: 可以存下一个图案
			}
			ScrollMedium: {
				DisplayName: 中型卷轴
				Tooltip: 可以存下一个图案
			}
			ScrollLarge: {
				DisplayName: 大型卷轴
				Tooltip: 可以存下一个图案
			}
			DeepslateItem: {
				DisplayName: 深板岩
				Tooltip:
					'''
					石块和紫水晶粉压实而成的深层岩石
					用来制作石板和板岩块
					'''
			}
			HexSlateItem: {
				DisplayName: 空白石板
				WrittenName: 有图案的石板
				Tooltip:
					'''
					法术环的一块「指令」
					用手上存着图案的物品右键 → 写入图案
					空手右键 → 顺时针转 90° 改朝向
					朝向必须垂直于控制流方向，否则环走不通
					'''
			}
			HexImpetusItem: {
				DisplayName: 工具匠促动石
				Tooltip:
					'''
					法术环的起点：不潜行右键启动
					拿着媒质物品右键：把媒质塞进去
					放置时出口朝向鼠标方向
					'''
			}
			HexImpetusEmptyItem: {
				DisplayName: 空白促动石
				Tooltip:
					'''
					媒质只从箭头方向流出
					对站在上面的哥布林工匠 / 军火商 / 护士施「脑叶切除」，变成三种促动石
					'''
			}
			HexImpetusRedstoneItem: {
				DisplayName: 牧师促动石
				Tooltip:
					'''
					法术环的起点：收到电线信号时启动
					拿着存有玩家的核心右键：绑定该玩家
					拿着媒质物品右键：把媒质塞进去
					'''
			}
			HexImpetusLookItem: {
				DisplayName: 制箭师促动石
				Tooltip:
					'''
					法术环的起点：盯着它看 1.5 秒启动
					拿着媒质物品右键：把媒质塞进去
					放置时出口朝向鼠标方向
					'''
			}
			HexDirectrixEmptyItem: {
				DisplayName: 空白导向石
				Tooltip:
					'''
					媒质沿轴随机从一端流出
					放置时轴向朝向鼠标方向
					'''
			}
			HexDirectrixBooleanItem: {
				DisplayName: 牧羊人导向石
				Tooltip:
					'''
					弹出栈顶布尔值：真从箭头反方向流出、假从箭头方向流出
					放置时轴向朝向鼠标方向
					'''
			}
			HexDirectrixRedstoneItem: {
				DisplayName: 石匠导向石
				Tooltip:
					'''
					通电时从箭头方向流出，否则从反方向
					放置时轴向朝向鼠标方向
					'''
			}
		}
