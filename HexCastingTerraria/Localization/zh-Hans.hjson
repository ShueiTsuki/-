			DevStaff: {
				DisplayName: 咒法学开发者法杖
				Tooltip:
					'''
					右键打开咒术绘制画布
					潜行右键清空已绘制图案
					画布内：左键拖拽绘制 · 右键撤销 · Esc 关闭 · F1 调试面板
					'''
			}
			AncientScroll: {
				DisplayName: 远古卷轴
				Tooltip:
					'''
					写着本世界某个大法术的笔顺（大法术的笔顺每个世界都不一样）
					只能在箱子里找到
					'''
			}
			AncientCypher: {
				DisplayName: 远古杂件
				Tooltip:
					'''
					封着一段古人留下的咒术，自带媒质，用完即毁
					只能在箱子里找到
					'''
			}
			LoreFragment: {
				DisplayName: 故事残卷
				Tooltip:
					'''
					阅读后，咒法学之书里会多出一篇传说
					只能在箱子里找到
					'''
			}
			MediaFlask: {
				DisplayName: 媒质瓶
				Tooltip:
					'''
					施法时最先从这里扣媒质
					用「制作试剂瓶」法术把地上的媒质装进空瓶制得，「重新充能」可补满
					'''
			}
			AmethystDust: {
				DisplayName: 紫水晶粉
				Tooltip:
					'''
					蕴含着 10,000 媒质
					媒质的基本单位 —— 一切咒术都从这里开始
					施法时直接从背包扣取
					'''
			}
			AmethystShard: {
				DisplayName: 紫水晶碎片
				Tooltip:
					'''
					蕴含着 50,000 媒质（5 粉）
					施法时直接从背包扣取
					'''
			}
			ChargedAmethyst: {
				DisplayName: 充能紫水晶
				Tooltip:
					'''
					蕴含着 100,000 媒质（10 粉）
					晶体中封存着尚未散去的思绪
					施法时直接从背包扣取
					'''
			}
			QuenchedAllayShard: {
				DisplayName: 淬灵晶碎片
				Tooltip:
					'''
					蕴含着 300,000 媒质（30 粉）
					某个曾经欢快之物，如今只剩冰冷的安宁
					施法时直接从背包扣取
					'''
			}
		}
			AmethystDustBlockItem: {
				DisplayName: 紫水晶粉块
				Tooltip: 压实的紫水晶粉，可作建材
			}
