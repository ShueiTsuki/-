	Tooltip: Great spell parsing

	All: {
		Label: All
		Tooltip: ""
	}

	Disabled: {
		Label: Disabled
		Tooltip: ""
	}

	ByScroll: {
		Label: By scroll
		Tooltip: ""
	}

}

CommentMode: {
	Tooltip: Comment / indent parsing

	Disabled: {
		Label: Disabled
		Tooltip: ""
	}

	Manual: {
		Label: Manual
		Tooltip: ""
	}

	All: {
		Label: All
		Tooltip: ""
	}

}

UnknownMode: {
	Tooltip: Iotas without a text form

	Simple: {
		Label: UNKNOWN
		Tooltip: ""
	}

	ShowNbt: {
		Label: UNKNOWN with data
		Tooltip: ""
	}

	KeepNbt: {
		Label: Keep as nbt_
		Tooltip: ""
	}

}

HexcessibleOptions: {
	Tooltip: Hexcessible options (upstream HexcessibleConfig, same defaults)

	Dimmed: {
		Label: Dim UI
		Tooltip: Dim the background of the spellcasting interface
	}

	PrefersReducedMotion: {
		Label: Prefers Reduced Motion
		Tooltip: Disable some moving animations in the spellcasting interface
	}

	ShowAllDots: {
		Label: Show all dots
		Tooltip: Show all dots in the spellcasting interface, instead of just the ones close to your cursor
	}

	TooltipRenderSigs: {
		Label: Render Pattern
		Tooltip: Render patterns in Hexcessible UIs, like Autocomplete or Idle Hover
	}

	KeyDocs: {
		Label: N for Docs
		Tooltip: Press the N key while casting to open the book
	}

	IdleTooltip: {
		Label: Idling in Spellcasting Interface: show hover tooltip
		Tooltip: Shown after hovering a drawn pattern for half a second
	}

	MouseDrawTooltip: {
		Label: Spellcasting with Mouse: show tooltip
		Tooltip: ""
	}

	KeyboardAllow: {
		Label: Spellcasting with Keyboard
		Tooltip: Draw with q w e a d; Enter / Tab / Space to cast; s or Backspace to undo; arrows / hjkl to move; r to rotate
	}

	KeyboardTooltip: {
		Label: Keyboard drawing: show tooltip
		Tooltip: ""
	}

	KeyHint: {
		Label: Show key hints
		Tooltip: When keyboard drawing, show markers for the keys you can press to advance drawing
	}

	Ghost: {
		Label: Ghost preview
		Tooltip: Preview where you're trying to place it (even if it can't place there)
	}

	AutoCompleteAllow: {
		Label: Magic Autocomplete
		Tooltip: Ctrl+Space, or type while holding a dot: search patterns by name, Enter / Tab to pick
	}

	AutoCompleteTooltip: {
		Label: Autocomplete: show description panel
		Tooltip: ""
	}

	AutoCompleteCount: {
		Label: Autocomplete: option count
		Tooltip: Number of options to show on one page
	}

	ShortcutHints: {
		Label: Hint at Shortcuts
		Tooltip: Show shortcuts in the bottom left of the UI
	}

	UppercaseSig: {
		Label: Uppercase Signature
		Tooltip: Represent a signature, e.g. qaq, as QAQ
	}

}

TooltipMode: {
	Tooltip: Tooltip

	Hidden: {
		Label: No
		Tooltip: ""
	}

	Simple: {
		Label: Simple
		Tooltip: ""
	}

	Descriptive: {
		Label: Descriptive
		Tooltip: ""
	}

}

KeyDocsMode: {
	Tooltip: N for Docs

	Off: {
		Label: No
		Tooltip: ""
	}

	Idling: {
		Label: When Idle
		Tooltip: ""
	}

	Always: {
		Label: Always
		Tooltip: ""
	}
}

HexDebugOptions: {
	Tooltip: HexDebug options

	MaxDebugThreads: {
		Label: Max debug threads
		Tooltip: How many hexes can be debugged at once after enlightenment (Quenched Debugger switches threads); 1 before.
	}
}
