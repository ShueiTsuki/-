				DisplayName: Focus
				Tooltip:
					'''
					Holds a single iota
					Pair with read_into_parens to carry a value around
					'''
			}
			ThoughtKnot: {
				DisplayName: Thought Knot
				Tooltip:
					'''
					Holds a single iota
					The knot remembers a thought; it does not come undone
					'''
			}
			ScrollSmall: {
