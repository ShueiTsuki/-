			}
			AshStaff: {
				DisplayName: Ash Wood Staff
				Tooltip: Right click to draw a hex pattern
			}
			QuenchedStaff: {
				DisplayName: Quenched Shard Staff
				Tooltip: Forged of quenched alloy; peace echoes within the crystal
			}
			EdifiedStaff: {
				DisplayName: Edified Staff
				Tooltip: Thoughts flow along the grain of this wood
			}
			MindspliceStaff: {
				DisplayName: Mindsplice Staff
				Tooltip: Splits thought itself to glimpse the structure beneath
			}
			Focus: {
				DisplayName: Focus
				Tooltip:
					'''
					Holds a single iota
					Pair with read_into_parens to carry a value around
					'''
			}
			ThoughtKnot: {
				DisplayName: Thought Knot
				Tooltip:
					'''
					Holds a single iota
					The knot remembers a thought; it does not come undone
					'''
			}
			ScrollSmall: {
				DisplayName: Small Scroll
				Tooltip: Holds a single pattern
			}
			ScrollMedium: {
				DisplayName: Medium Scroll
				Tooltip: Holds a single pattern
			}
			ScrollLarge: {
				DisplayName: Large Scroll
				Tooltip: Holds a single pattern
			}
			HexSlateItem: {
				DisplayName: Hex Slate
				Tooltip:
					'''
					One instruction of a spell circle
					Right click holding a pattern item to write the pattern
					Right click empty-handed to rotate 90° clockwise
					Orientation must be perpendicular to the control flow
					'''
			}
			HexImpetusItem: {
				DisplayName: Hex Impetus
				Tooltip:
					'''
					The heart of a spell circle
					It holds no patterns itself -- patterns live on slates
					Right click to start; closure is validated first
					'''
			}
			HexDirectrixEmptyItem: {
				DisplayName: Empty Directrix
				Tooltip:
					'''
					A spell circle splitter
					Randomly picks one end of its axis -- use it for chance branches
					Right click empty-handed to rotate the axis
					'''
			}
			HexDirectrixBooleanItem: {
				DisplayName: Boolean Directrix
				Tooltip:
					'''
					A spell circle splitter, and the only branch structure
					Pops a boolean: true exits one way, false the other
					Right click empty-handed to rotate the axis
					'''
			}
			HexDirectrixRedstoneItem: {
				DisplayName: Redstone Directrix
				Tooltip:
					'''
					A spell circle splitter
					Powered exits one way, unpowered the other
					Right click empty-handed to rotate the axis
					'''
			}
