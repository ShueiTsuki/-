			DevStaff: {
				DisplayName: Hexcasting Dev Staff
				Tooltip:
					'''
					Right click to open the hex drawing canvas
					Shift + right click to clear drawn patterns
					In canvas: hold LMB to draw, RMB to undo, Esc to close, F1 for debug
					'''
			}

			AncientScroll: {
				DisplayName: Ancient Scroll
				Tooltip:
					'''
					Holds this world's stroke order for one Great Spell
					Only found in chests
					'''
			}
			AncientCypher: {
				DisplayName: Ancient Cypher
				Tooltip:
					'''
					A hex left behind by someone long gone; carries its own media and breaks when used
					Only found in chests
					'''
			}
			LoreFragment: {
				DisplayName: Lore Fragment
				Tooltip:
					'''
					Read it to unlock a lore entry in the Hex Book
					Only found in chests
					'''
			}
			MediaFlask: {
				DisplayName: Media Flask
				Tooltip:
					'''
					Media is drawn from here first when casting
					Made with Craft Phial from media on the ground; refill with Recharge Item
					'''
			}

			AmethystDust: {
				DisplayName: Amethyst Dust
				Tooltip:
					'''
					Holds 10,000 media
					The base unit of media -- every hex starts here
					Spent straight from your inventory when casting
					'''
			}

			AmethystShard: {
				DisplayName: Amethyst Shard
				Tooltip:
					'''
					Holds 50,000 media (5 dust)
					Spent straight from your inventory when casting
					'''
			}

			ChargedAmethyst: {
				DisplayName: Charged Amethyst
				Tooltip:
					'''
					Holds 100,000 media (10 dust)
					A thought not yet dispersed, sealed in crystal
					Spent straight from your inventory when casting
					'''
			}

			QuenchedAllayShard: {
				DisplayName: Shard of Quenched Allay
				Tooltip:
					'''
					Holds 300,000 media (30 dust)
					Something once joyful, now only cold peace
					Spent straight from your inventory when casting
					'''
			}
		}

