			DeepslateItem: {
				DisplayName: Deepslate
				Tooltip:
					'''
					Stone pressed together with amethyst dust
					Used to make slates and slate blocks
					'''
			}
			HexSlateItem: {
				DisplayName: Blank Slate
				WrittenName: Patterned Slate
				Tooltip:
					'''
					One instruction of a spell circle
					Right click holding a pattern item to write the pattern
					Right click empty-handed to rotate 90° clockwise
					Orientation must be perpendicular to the control flow
					'''
			}
			HexImpetusItem: {
				DisplayName: Toolsmith Impetus
				Tooltip:
					'''
					Starts a spell circle when right-clicked
					Right-click holding a media item to insert its media
					Faces the mouse direction when placed
					'''
			}
			HexImpetusEmptyItem: {
				DisplayName: Empty Impetus
				Tooltip:
					'''
					Media flows out only in the direction of the arrow
					Brainsweep a Goblin Tinkerer / Arms Dealer / Nurse standing on it to make an impetus
					'''
			}
			HexImpetusRedstoneItem: {
				DisplayName: Cleric Impetus
				Tooltip:
					'''
					Starts a spell circle on a wire signal
					Right-click with a focus holding a player to bind them
					Right-click holding a media item to insert its media
					'''
			}
			HexImpetusLookItem: {
				DisplayName: Fletcher Impetus
				Tooltip:
					'''
					Starts a spell circle after being looked at for 1.5 seconds
					Right-click holding a media item to insert its media
					Faces the mouse direction when placed
					'''
			}
			HexDirectrixEmptyItem: {
				DisplayName: Empty Directrix
				Tooltip:
					'''
					Media leaves from a random end of its axis
					Faces the mouse direction when placed
					'''
			}
			HexDirectrixBooleanItem: {
				DisplayName: Shepherd Directrix
				Tooltip:
					'''
					Pops a boolean: true exits against the arrow, false along it
					Faces the mouse direction when placed
					'''
			}
			HexDirectrixRedstoneItem: {
				DisplayName: Mason Directrix
				Tooltip:
					'''
					Powered: exits along the arrow; otherwise against it
					Faces the mouse direction when placed
					'''
			}
		}
