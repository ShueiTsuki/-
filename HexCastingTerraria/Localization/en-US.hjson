# Hex Casting -> tModLoader port
# Key format: Mods.{ModInternalName}.{Category}.{ClassName}.{Field}
# File name must be {language}.hjson
# (do not confuse with the Configs-only format {language}_Mods.{Name}.Configs.hjson)

Mods: {
	HexCastingTerraria: {
		Misc: {
			OnlyHostCanChangeAddons: Only the host can change addon settings
		}

		// Hexcessible 附属（上游 lang 文件的官方译文）
		// HexDebug 附属（消息是上游 lang 文件的官方译文；调试面板的标签是移植版自己的）
		HexDebug: {
			Connected: Debug client connected!
			NoSession: Debug session is not running for thread {0}.
			NotPaused: Debug session is not paused for thread {0}.
			DebuggerStopped: "Next Iota: [{0}] {1}"
			IllegalThread: The item failed, somehow... am I not skilled enough?
			OutOfRange: Debuggee is out of range.
			ThreadInactive: Thread {0}
			ThreadActive: Thread {0} ({1})

			StepMode: {
				Continue: "Mode: Continue"
				Over: "Mode: Step Over"
				In: "Mode: Step In"
				Out: "Mode: Step Out"
				Restart: "Mode: Restart"
				Stop: "Mode: Stop"
			}

			CircleName: Spell circle
			FocusHolderItemIs: Item: {0}

			BadBlock: {
				SplicingTable: a Splicing Table
				Enlightened: a Mindsplice Table
				ClipboardRead: a Splicing Table with a readable secondary item
				ClipboardWrite: a Splicing Table with a writable secondary item
				ClipboardSpellbook: a Splicing Table with a non-empty spellbook in the secondary item slot
				TableOrHolder: a Splicing Table or Focal Frame
				TableOrHolderSpellbook: a Splicing Table or Focal Frame with a non-empty spellbook in the main item slot
				PositiveOrNull: a positive integer or null
				PositiveInt: a positive integer
				IntBetween: an integer between {0} and {1}
			}

			Splicing: {
				MediaBar: Media: {0} / {1}
				NoList: Put a list holder (focus, spellbook...) in the list slot
				ClipboardIs: Clipboard: {0}
				Draw: Draw
				Cast: Cast

				Button: {
					ViewLeft: Move View Left
					ViewLeftPage: Move View to Previous Page
					ViewLeftFull: Move View to Start
					ViewRight: Move View Right
					ViewRightPage: Move View to Next Page
					ViewRightFull: Move View to End
					CursorLeft: Move Cursor Left
					CursorRight: Move Cursor Right
					ExpandSelectionLeft: Expand Selection Left
					ExpandSelectionRight: Expand Selection Right
					MoveSelectionLeft: Move Selection Left
					MoveSelectionRight: Move Selection Right
					SelectNone: Select None
					SelectAll: Select All
					Undo: Undo
					Redo: Redo
					NudgeLeft: Nudge Left
					NudgeRight: Nudge Right
					Duplicate: Duplicate
					Delete: Delete
					Backspace: Backspace
					Cut: Cut
					Copy: Copy
					PasteVerbatim: Paste (Verbatim)
					PasteSplat: Paste (Splat)
					Export: Export as .hexpattern
				}

				Short: {
					CursorLeft: Cur<
					CursorRight: Cur>
					ExpandSelectionLeft: Ext<
					ExpandSelectionRight: Ext>
					MoveSelectionLeft: Sel<
					MoveSelectionRight: Sel>
					SelectNone: None
					SelectAll: All
					Undo: Undo
					Redo: Redo
					NudgeLeft: Nudge<
					NudgeRight: Nudge>
					Duplicate: Dup
					Delete: Del
					Backspace: Bksp
					Cut: Cut
					Copy: Copy
					PasteVerbatim: Paste
					PasteSplat: Splat
				}

				Tooltip: {
					Index: Index: {0}
					Depth: Depth: {0}
					Signature: Signature: {0}
					Length: Length: {0}
				}

				Slot: {
					List: List
					Clipboard: Clipboard
					Media: Media
					Staff: Staff
				}
			}

			Panel: {
				Because: " ({0})"
				Source: Source #{0}
				Empty: (empty)
				Stack: Stack ({0})
				More: "{0} more"
				Ravenmind: Ravenmind: {0}
				State3: OpsConsumed {0} · EscapeNext {1} · ParenCount {2}
				Yes: true
				No: false
				Frames: Call stack
				Output: Output
				Hint: Click a source line to toggle a breakpoint

				State: {
					Running: Running
					Pausing: Pausing
					Paused: Paused
					CaughtMishap: Caught mishap
					Terminated: Terminated
				}

				Reason: {
					Step: step
					Pause: pause
					Breakpoint: breakpoint
					Exception: exception
					Started: entry
					Terminated: terminated
				}
			}
		}

		Hexcessible: {
			StartTypingAlias: Name this pattern...
			StartTyping: Start typing...
			CountLocked: "+{0} locked"
			WorldSpecificAutocomplete: This pattern is world-specific. Put an Ancient Scroll in the hotbar slot right of your held item, then start casting to learn it.
			NoSpace: Can't place this here
			CountQueued: "{0} more to go"

			SmartSig: {
				Prefix: "Based on your current stack, this will "
				Drop: drop {0} iotas
				Drop1: drop one iota
				Keep: keep {0} iotas
				Keep1: keep one iota
				Join: ", then "
				Suffix: "."
			}

			Hint: {
				DrawStart: draw
				AutoComplete: autocomplete
				Cast: cast
				Move: move
				Rotate: rotate
				Scroll: scroll
				ScrollDefinitions: definitions
				Search: search
				Alias: alias this
				AliasOff: remove alias
				Undo: undo
			}
		}

		Prefixes: {
			Resonant: {
				DisplayName: Resonant
				Effect: Mines Quenched Allay blocks intact, as Silk Touch would
			}
		}

		Buffs: {
			Resonance: {
				DisplayName: Resonance
				Description: You can now harvest certain things without breaking them
			}
		}

		Conditions: {
			Sealable: The first one of this item in your inventory holds something and is not sealed
			Enlightened: Enlightened
		}

