<Project Sdk="Microsoft.NET.Sdk">
  <!--
    咒法学 (Hex Casting) → 泰拉瑞亚 tModLoader 移植
    目标：tModLoader 1.4.4.9（stable 分支）。2026-10-01 从 1.4.5-dev 退回（git tag last-tml-1.4.5-dev）。
      TargetFramework = net8.0    （由 tMLMod.targets 提供）
      LangVersion     = 12.0      （同上；两个测试工程也钉 12.0，保证 Core 不用新语法）
  -->
  <Import Project="D:\steam\steamapps\common\tModLoader\tMLMod.targets" />

  <PropertyGroup>
    <AssemblyName>HexCastingTerraria</AssemblyName>
    <RootNamespace>HexCastingTerraria</RootNamespace>
    <!-- 显式声明，否则当 BuildMod=false（只做语法检查、不打包）时
         tMLMod.targets 不会设置 TargetFramework，导致 NETSDK1013。 -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
</Project>
