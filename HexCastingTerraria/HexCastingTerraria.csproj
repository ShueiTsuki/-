<Project Sdk="Microsoft.NET.Sdk">
  <!--
    咒法学 (Hex Casting) → 泰拉瑞亚 tModLoader 移植
    目标：tModLoader 1.4.5（1.4.5-dev 分支）
      TargetFramework = net10.0   （由 tMLMod.targets 提供，1.4.5 起从 net8.0 升级）
      LangVersion     = 14.0      （同上，1.4.4 是 12.0）
    注意：1.4.5 起安装路径属性为 tModLoaderSteamPath（旧名 tMLSteamPath 已 obsolete）。
  -->
  <Import Project="D:\steam\steamapps\common\tModLoader\tMLMod.targets" />

  <PropertyGroup>
    <AssemblyName>HexCastingTerraria</AssemblyName>
    <RootNamespace>HexCastingTerraria</RootNamespace>
    <!-- 显式声明，否则当 BuildMod=false（只做语法检查、不打包）时
         tMLMod.targets 不会设置 TargetFramework，导致 NETSDK1013。 -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
</Project>
